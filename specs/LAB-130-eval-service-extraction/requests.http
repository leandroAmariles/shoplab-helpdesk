  "dataset_hash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "cases_measured": 1,
  "cases_excluded": 0,
  "embedding_model": "bge-m3",
  "prompts": [],
  "retrieval_config": {
    "top_k": 4,
    "similarity_threshold": 0.6,
    "max_context_characters": 8000,
    "depth": 20,
    "ks": [1, 3, 5]
  },
  "results": [
    {
      "case": {
        "id": "G501",
        "category": "returns",
        "question": "¿Cuál es el plazo estándar para devolver un producto en buen estado?",
        "reference_answer": "El plazo estándar para devolver un producto sin usar es de treinta días naturales desde la entrega.",
        "expected_documents": ["returns-policy"]
      },
      "case_kind": "answered",
      "scores": {
        "reciprocal_rank": 1.0,
        "hit_at_1": 1.0,
        "hit_at_3": 1.0,
        "hit_at_5": 1.0,
        "recall_at_1": 1.0,
        "recall_at_3": 1.0,
        "recall_at_5": 1.0
      },
      "retrieved_documents": ["returns-policy"]
    }
  ]
}

### 12. FR-008, FR-009 & US3 Scenario 4 — List history runs WITHOUT token (boundary limit=500 max allowed) — expects 200
GET {{baseUrl}}/api/eval/history/runs?kind=QUALITY&limit=500

> {%
client.test("200 history list without token", function() {
  client.assert(response.status === 200, "Expected 200");
  client.assert(response.body.kind === "QUALITY", "Expected QUALITY");
});
%}

