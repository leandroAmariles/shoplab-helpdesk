### 8. Edge Case "Cuerpo con propiedades desconocidas / texto de respuesta prohibido (FR-012)" — expects 400 SLHD_GENE_00002
POST {{baseUrl}}/api/eval/runs
Content-Type: application/json
X-Eval-Token: {{evalToken}}

{
  "run_id": "lab130-unknown-prop",
  "kind": "QUALITY",
  "unexpected_answer_text": "must-never-be-accepted"
}

> {%
client.test("400 unknown property rejected", function() {
  client.assert(response.status === 400, "Expected 400");
  client.assert(response.body.code === "SLHD_GENE_00002", "Expected SLHD_GENE_00002");
});
%}

### 9. Rule Boundary: Score outside [0.0, 1.0] (1.01 > 1.0) — expects 422 SLHD_EVAL_00002
POST {{baseUrl}}/api/eval/runs
Content-Type: application/json
X-Eval-Token: {{evalToken}}

{
  "run_id": "lab130-invalid-score",
  "kind": "QUALITY",
  "started_at": "2026-11-26T12:00:00Z",
  "finished_at": "2026-11-26T12:05:00Z",
  "origin": "local",
  "dataset_hash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "cases_measured": 1,
  "cases_excluded": 0,
  "embedding_model": "bge-m3",
  "prompts": [
    {"name": "chat-system", "version": 3, "source": "LANGFUSE", "pinned": false},
    {"name": "chat-small-talk", "version": null, "source": "DEFAULT", "pinned": false},
    {"name": "chat-context", "version": null, "source": "DEFAULT", "pinned": false},
    {"name": "chat-empty-context", "version": null, "source": "DEFAULT", "pinned": false}
  ],
  "judge": {"model": "judge"},
  "evaluator": {"library": "ragas"},
  "retrieval_config": {"top_k": 4, "similarity_threshold": 0.6, "max_context_characters": 8000},
  "results": [
    {
      "case": {
        "id": "G501",
        "category": "returns",
        "question": "¿Cuál es el plazo estándar para devolver un producto en buen estado?",
        "reference_answer": "El plazo estándar para devolver un producto sin usar es de treinta días naturales desde la entrega.",
        "expected_documents": ["returns-policy"]
      },
      "case_kind": "answered",
      "scores": {"faithfulness": 1.01},
      "retrieved_documents": ["returns-policy"],
      "abstained": false
    }
  ]
}

> {%
client.test("422 invalid score > 1.0", function() {
  client.assert(response.status === 422, "Expected 422");
  client.assert(response.body.code === "SLHD_EVAL_00002", "Expected SLHD_EVAL_00002");
});
%}

