# HTTP test requests for LAB-130 (eval-service extraction)
# Generated per .ai/rules/http-test-requests.md from specs/LAB-130-eval-service-extraction/spec.md
#
# Not covered here (non-HTTP / infrastructure / CI-only requirements):
# - FR-001, FR-002: Repo creation from template & ArchUnit zero monolith/chat code dependency check
# - FR-003..FR-006: Dedicated PostgreSQL role/DB, pg_dump/pg_restore migration, MD5 & IDENTITY sequence verification
# - FR-010, FR-015: OpenAPI publication in shoplab-contracts & Spring Cloud Contract producer/consumer stub tests
# - FR-020..FR-027: Argo CD ApplicationSet deployment, cutover window, monolith retirement, Olist preservation & ADR-0035

@baseUrl = http://localhost:8080
@evalToken = change-me-local-only
@runBase = lab130-http-1
@runTarget = lab130-http-2
@runRetrieval = lab130-ret-1

### 1. FR-009 / Edge Case "Ejecución sin token" — POST /api/eval/runs without X-Eval-Token expects 403 SLHD_EVAL_00001
POST {{baseUrl}}/api/eval/runs
Content-Type: application/json

{
  "run_id": "{{runBase}}",
  "kind": "QUALITY"
}

> {%
client.test("403 without token", function() {
  client.assert(response.status === 403, "Expected 403");
  client.assert(response.body.code === "SLHD_EVAL_00001", "Expected SLHD_EVAL_00001");
});
%}

### 2. FR-009 / Edge Case "Ejecución con token inválido" — GET /api/eval/settings with wrong token expects 403 SLHD_EVAL_00001
GET {{baseUrl}}/api/eval/settings
X-Eval-Token: invalid-token-placeholder

> {%
client.test("403 with wrong token", function() {
  client.assert(response.status === 403, "Expected 403");
  client.assert(response.body.code === "SLHD_EVAL_00001", "Expected SLHD_EVAL_00001");
});
%}

### 3. US2 Scenario 1 & FR-013, FR-014 — GET /api/eval/settings reads active assistant settings from chat-service — expects 200 (or 503 SLHD_EVAL_00005 if chat-service is down, US2 Scenario 2 / FR-016)
GET {{baseUrl}}/api/eval/settings
X-Eval-Token: {{evalToken}}
X-Request-Id: req-lab130-settings-01
traceparent: 00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01

> {%
client.test("200 settings or 503 SLHD_EVAL_00005 when chat-service is down", function() {
  client.assert(response.status === 200 || response.status === 503, "Expected 200 or 503");
  if (response.status === 200) {
    client.assert(response.body.retrieval !== undefined, "Expected retrieval block");
    client.assert(Array.isArray(response.body.prompts), "Expected prompts array");
  } else {
    client.assert(response.body.code === "SLHD_EVAL_00005", "Expected SLHD_EVAL_00005");
  }
});
%}

### 4. US1 Scenario 3 & FR-007 — GET /api/eval/runs/{runId} before saving — expects 404 SLHD_EVAL_00004
GET {{baseUrl}}/api/eval/runs/{{runBase}}
X-Eval-Token: {{evalToken}}

> {%
client.test("404 before run is saved", function() {
  client.assert(response.status === 404, "Expected 404");
  client.assert(response.body.code === "SLHD_EVAL_00004", "Expected SLHD_EVAL_00004");
});
%}

### 5. US1 Scenario 3, US3 Scenario 3 & FR-007, FR-012 — Save first QUALITY evaluation run — expects 201
POST {{baseUrl}}/api/eval/runs
Content-Type: application/json
X-Eval-Token: {{evalToken}}

{
  "run_id": "{{runBase}}",
  "kind": "QUALITY",
  "started_at": "2026-11-26T12:00:00Z",
  "finished_at": "2026-11-26T12:05:00Z",
  "origin": "local",
  "commit_sha": "0123456789abcdef0123456789abcdef01234567",
  "dataset_hash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "cases_measured": 2,
  "cases_excluded": 0,
  "assistant_model": "chat",
  "embedding_model": "bge-m3",
  "prompts": [
    {"name": "chat-system", "version": 3, "source": "LANGFUSE", "pinned": false},
    {"name": "chat-small-talk", "version": null, "source": "DEFAULT", "pinned": false},
    {"name": "chat-context", "version": null, "source": "DEFAULT", "pinned": false},
    {"name": "chat-empty-context", "version": null, "source": "DEFAULT", "pinned": false}
  ],
  "judge": {
    "model": "judge",
    "underlying_model": "ollama_chat/qwen2.5:7b",
    "temperature": 0.0,
    "seed": 42,
    "max_input_chars": 6000
  },
  "evaluator": {
    "library": "ragas",
    "library_version": "0.3.5",
    "judgment_instructions_version": "2"
  },
  "retrieval_config": {
    "top_k": 4,
    "similarity_threshold": 0.6,
    "max_context_characters": 8000
  },
  "results": [
    {
      "case": {
        "id": "G501",
        "category": "returns",
        "question": "¿Cuál es el plazo estándar para devolver un producto en buen estado?",
        "reference_answer": "El plazo estándar para devolver un producto sin usar es de treinta días naturales desde la entrega.",
        "expected_documents": ["returns-policy"]
      },
      "case_kind": "answered",
      "scores": {
        "faithfulness": 0.90,
        "answer_relevancy": 0.85,
        "context_precision": 1.0
      },
      "retrieved_documents": ["returns-policy"],
      "abstained": false,
      "trace_id": "4bf92f3577b34da6a3ce929d0e0e4736"
    },
    {
      "case": {
        "id": "G502",
        "category": "payments",
        "question": "¿Qué medios de pago acepta la tienda para compras en línea?",
        "reference_answer": "La tienda acepta tarjetas de crédito, débito y transferencia bancaria según las condiciones vigentes.",
        "expected_documents": ["payments-policy"]
      },
      "case_kind": "answered",
      "scores": {
        "faithfulness": 0.80,
        "answer_relevancy": 0.80,
        "context_precision": 0.50
      },
      "retrieved_documents": ["payments-policy"],
      "abstained": false,
      "trace_id": null
    }
  ]
}

> {%
client.test("201 run saved", function() {
  client.assert(response.status === 201, "Expected 201");
  client.assert(response.body.run_id === "lab130-http-1", "Expected run_id");
});
%}

### 6. US1 Scenario 4 & Edge Case "Mismo identificador guardado dos veces" — Duplicate run_id expects 409 SLHD_EVAL_00003
POST {{baseUrl}}/api/eval/runs
Content-Type: application/json
X-Eval-Token: {{evalToken}}

{
  "run_id": "{{runBase}}",
  "kind": "QUALITY",
  "started_at": "2026-11-26T12:00:00Z",
  "finished_at": "2026-11-26T12:05:00Z",
  "origin": "local",
  "dataset_hash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "cases_measured": 1,
  "cases_excluded": 0,
  "embedding_model": "bge-m3",
  "prompts": [
    {"name": "chat-system", "version": 3, "source": "LANGFUSE", "pinned": false},
    {"name": "chat-small-talk", "version": null, "source": "DEFAULT", "pinned": false},
    {"name": "chat-context", "version": null, "source": "DEFAULT", "pinned": false},
    {"name": "chat-empty-context", "version": null, "source": "DEFAULT", "pinned": false}
  ],
  "judge": {
    "model": "judge",
    "underlying_model": "ollama_chat/qwen2.5:7b",
    "temperature": 0.0,
    "seed": 42,
    "max_input_chars": 6000
  },
  "evaluator": {"library": "ragas", "library_version": "0.3.5", "judgment_instructions_version": "2"},
  "retrieval_config": {"top_k": 4, "similarity_threshold": 0.6, "max_context_characters": 8000},
  "results": [
    {
      "case": {
        "id": "G501",
        "category": "returns",
        "question": "¿Cuál es el plazo estándar para devolver un producto en buen estado?",
        "reference_answer": "El plazo estándar para devolver un producto sin usar es de treinta días naturales desde la entrega.",
        "expected_documents": ["returns-policy"]
      },
      "case_kind": "answered",
      "scores": {"faithfulness": 0.10, "answer_relevancy": 0.10, "context_precision": 0.10},
      "retrieved_documents": ["returns-policy"],
      "abstained": false
    }
  ]
}

> {%
client.test("409 duplicate run_id", function() {
  client.assert(response.status === 409, "Expected 409");
  client.assert(response.body.code === "SLHD_EVAL_00003", "Expected SLHD_EVAL_00003");
});
%}

