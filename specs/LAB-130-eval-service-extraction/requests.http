GET {{baseUrl}}/api/eval/history/runs?kind=QUALITY&limit=501

> {%
client.test("422 limit > 500", function() {
  client.assert(response.status === 422, "Expected 422");
  client.assert(response.body.code === "SLHD_EVAL_00002", "Expected SLHD_EVAL_00002");
});
%}

### 14. FR-008, FR-012 & US3 Scenario 4 — Get history run detail WITHOUT token (no answer/chunk text stored) — expects 200
GET {{baseUrl}}/api/eval/history/runs/{{runBase}}

> {%
client.test("200 run detail with trace_url and no answer text", function() {
  client.assert(response.status === 200, "Expected 200");
  client.assert(response.body.run.run_id === "lab130-http-1", "Expected run_id");
});
%}

### 15. US3 Scenario 4 & 5 — Compare two QUALITY runs (default drop=0.05) — expects 200
GET {{baseUrl}}/api/eval/history/compare?base={{runBase}}&target={{runTarget}}&metric=faithfulness&drop=0.05

> {%
client.test("200 run comparison", function() {
  client.assert(response.status === 200, "Expected 200");
  client.assert(response.body.counts.worse === 1, "Expected 1 worse case");
  client.assert(response.body.counts.better === 1, "Expected 1 better case");
});
%}

### 16. Edge Case / Rule Boundary: Compare runs of different kinds (QUALITY vs RETRIEVAL) — expects 422 SLHD_EVAL_00006
GET {{baseUrl}}/api/eval/history/compare?base={{runBase}}&target={{runRetrieval}}&metric=faithfulness

> {%
client.test("422 non-comparable kinds", function() {
  client.assert(response.status === 422, "Expected 422");
  client.assert(response.body.code === "SLHD_EVAL_00006", "Expected SLHD_EVAL_00006");
});
%}
