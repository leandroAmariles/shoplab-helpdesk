### FR-007 / US3 Escenario 2 (justo en el límite) - mensaje de exactamente 4000 caracteres: se acepta, 200
< {% request.variables.set("message4000", "x".repeat(4000)); %}
POST {{baseUrl}}/api/chat
Content-Type: application/json
Accept: text/event-stream

{ "message": "{{message4000}}" }

> {%
    client.test("acepta 4000 caracteres", function () {
        client.assert(response.status === 200, "esperado 200, recibido " + response.status);
    });
%}

### FR-007 / US3 Escenario 2 (justo fuera del límite) - mensaje de 4001 caracteres: 400 SLHD_CHAT_00001, sin llamar al modelo
< {% request.variables.set("message4001", "x".repeat(4001)); %}
POST {{baseUrl}}/api/chat
Content-Type: application/json
Accept: text/event-stream

{ "message": "{{message4001}}" }

> {%
    client.test("rechaza 4001 caracteres con 400", function () {
        client.assert(response.status === 400, "esperado 400, recibido " + response.status);
        client.assert(response.body.code === "SLHD_CHAT_00001", "código distinto");
    });
%}

### FR-008 / US3 Escenario 3 - modelo no disponible: 503 SLHD_CHAT_00002 (también con Accept: text/event-stream)
# Antes de enviarla: `docker compose -f infra/docker-compose.yml stop ollama`.
# Después: `docker compose -f infra/docker-compose.yml start ollama`.
POST {{baseUrl}}/api/chat
Content-Type: application/json
Accept: text/event-stream

{ "message": "Hola" }

> {%
    client.test("responde 503 con JSON cuando Ollama está parado", function () {
        client.assert(response.status === 503, "esperado 503, recibido " + response.status);
        client.assert(response.body.code === "SLHD_CHAT_00002", "código distinto");
    });
%}

### FR-013 / US2 Escenario 3 - métricas del chat en el punto de lectura de Prometheus
# Busca `shoplab_chat_first_token_seconds` y `shoplab_chat_response_seconds{...outcome="completed"...}`.
GET {{baseUrl}}/actuator/prometheus

> {%
    client.test("publica las métricas del chat", function () {
        client.assert(response.status === 200, "esperado 200, recibido " + response.status);
        client.assert(response.body.indexOf("shoplab_chat_first_token_seconds") >= 0, "falta la métrica del primer token");
        client.assert(response.body.indexOf("shoplab_chat_response_seconds") >= 0, "falta la métrica de la respuesta");
    });
%}
