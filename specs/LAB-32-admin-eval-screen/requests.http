### US3·1, US3·2 y FR-019 — comparación con el cambio deliberado de prompt, tolerancia 0,05 (frontera exacta) — expects 200
GET {{baseUrl}}/api/eval/history/compare?base=seed-q1&target=seed-q2&metric=faithfulness&drop=0.05

> {%
  client.test("200 con el prompt que cambió y los casos clasificados", function () {
    client.assert(response.status === 200);
    client.assert(response.body.parameters.some(function (p) {
      return p.field === "prompts.chat-system.version" && p.base === "3" && p.target === "4";
    }));
    client.assert(response.body.counts.worse > 0);
  });
%}

### US3·3 — el caso reescrito (G001) es no comparable y no figura entre los que empeoraron ni mejoraron — expects 200
GET {{baseUrl}}/api/eval/history/compare?base=seed-q1&target=seed-q2&metric=faithfulness

> {%
  client.test("G001 no comparable y sin valores", function () {
    client.assert(response.status === 200);
    const g001 = response.body.cases.find(function (c) { return c.case_id === "G001"; });
    client.assert(g001.status === "NOT_COMPARABLE");
    client.assert(g001.base_value === undefined && g001.target_value === undefined);
  });
%}

