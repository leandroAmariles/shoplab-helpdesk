### US2 / FR-008 y FR-009 — detalle de una ejecución de calidad: parámetros, resumen y resultados — expects 200
GET {{baseUrl}}/api/eval/history/runs/seed-q1

> {%
  client.test("200 con resumen y resultados", function () {
    client.assert(response.status === 200);
    client.assert(response.body.summary.length > 0);
    client.assert(response.body.results.length === 96);
  });
%}

### US1·5 y FR-013 — una métrica vacía por definición sale como media nula y n = 0, nunca 0 — expects 200
GET {{baseUrl}}/api/eval/history/runs/seed-q3

> {%
  client.test("context_precision sin valor", function () {
    client.assert(response.status === 200);
    const all = response.body.summary.find(function (s) { return s.scope === "all"; });
    client.assert(all.metrics.context_precision.mean === null);
    client.assert(all.metrics.context_precision.n === 0);
  });
%}

