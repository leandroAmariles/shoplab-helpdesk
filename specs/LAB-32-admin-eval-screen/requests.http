### US3·6 — recuperación con k distintos: solo se comparan las métricas que existen (hit_at_10 solo en r2) — expects 200
GET {{baseUrl}}/api/eval/history/compare?base=seed-r1&target=seed-r2&metric=reciprocal_rank

> {%
  client.test("200 con hit_at_10 solo en el objetivo", function () {
    client.assert(response.status === 200);
    const hit10 = response.body.metrics.find(function (m) { return m.metric === "hit_at_10"; });
    client.assert(hit10.base.mean === null && hit10.base.n === 0);
    client.assert(hit10.delta === null);
  });
%}

### FR-020 / sin token — la lectura funciona aunque se envíe un token de guardado equivocado (se ignora) — expects 200
GET {{baseUrl}}/api/eval/history/runs?kind=QUALITY&limit=1
X-Eval-Token: valor-que-no-se-usa

> {%
  client.test("200", function () { client.assert(response.status === 200); });
%}
