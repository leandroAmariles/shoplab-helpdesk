  });
%}

### Edge "Tildes y eñes" — una consulta con ¿?, tildes y eñe llega intacta — expects 200
# ¿Qué garantía cubre una reparación del año pasado?
GET {{baseUrl}}/api/knowledge/search?query=%C2%BFQu%C3%A9%20garant%C3%ADa%20cubre%20una%20reparaci%C3%B3n%20del%20a%C3%B1o%20pasado%3F&limit=5

> {%
  client.test("responde 200 con la forma esperada", function () {
    client.assert(response.status === 200 && Array.isArray(response.body.results), "respuesta inesperada");
  });
%}

### Contrato "Errores" — consulta en blanco — expects 422 SLHD_RETR_00009
GET {{baseUrl}}/api/knowledge/search?query=%20%20&limit=5

> {%
  client.test("422 con el código de consulta inválida", function () {
    client.assert(response.status === 422, "status esperado 422");
    client.assert(response.body.code === "SLHD_RETR_00009", "código esperado SLHD_RETR_00009");
  });
%}

### Contrato "Errores" — consulta ausente — expects 422 SLHD_RETR_00009
GET {{baseUrl}}/api/knowledge/search?limit=5

> {%
  client.test("422 con el código de consulta inválida", function () {
    client.assert(response.status === 422, "status esperado 422");
    client.assert(response.body.code === "SLHD_RETR_00009", "código esperado SLHD_RETR_00009");
  });
%}

### FR-014 "comprobación previa del índice" — el catálogo informa el nombre y el estado de cada documento — expects 200
# La medición exige que cada documento esperado esté en estado INDEXED antes de buscar.
GET {{baseUrl}}/api/documents
Accept: application/json

> {%
  client.test("responde 200 con una lista", function () {
    client.assert(response.status === 200 && Array.isArray(response.body), "se esperaba una lista");
  });
  client.test("cada documento trae name y status", function () {
    response.body.forEach(function (doc) {
      client.assert("name" in doc && "status" in doc, "falta name o status");
    });
  });
%}
