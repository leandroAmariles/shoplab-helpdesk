### SC-002 — Ningún rechazo dejó datos: los nombres rechazados no están en la lista — expects 200 sin lab25-*
GET {{baseUrl}}/api/documents
Accept: application/json

> {%
    client.test("sin restos de los rechazos", () => {
        const leftovers = response.body.filter(d => d.name.startsWith("lab25-") || d.name === "carpeta/" || d.name === "");
        client.assert(leftovers.length === 0, "quedaron: " + leftovers.map(d => d.name).join(", "));
    });
%}

### FR-014 — Métricas de subida y de documentos por estado, sin nombres como etiqueta — expects retrieval_upload_seconds_count{outcome=...} y retrieval_documents{status=...}
GET {{baseUrl}}/actuator/prometheus

> {%
    client.test("métricas presentes y sin nombres de documento", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.includes('retrieval_upload_seconds_count{application="helpdesk-backend",outcome="ok"}'), "falta outcome=ok");
        client.assert(response.body.includes('outcome="rejected"'), "falta outcome=rejected");
        client.assert(response.body.includes("retrieval_documents{"), "falta retrieval_documents");
        client.assert(!response.body.includes("returns-01-return-policy"), "un nombre de documento aparece en las métricas");
    });
%}
