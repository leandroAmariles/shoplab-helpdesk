> {% client.test("200", function() { client.assert(response.status === 200); }); %}

### FR-008 - limit en el máximo: expects 200 con hasta 50
GET {{baseUrl}}/api/knowledge/search?query=devoluciones&limit=50

> {% client.test("200", function() { client.assert(response.status === 200); }); %}

### FR-008 - limit por encima del máximo: expects 200, recortado a 50
GET {{baseUrl}}/api/knowledge/search?query=devoluciones&limit=51

> {% client.test("200", function() { client.assert(response.status === 200); }); %}

### FR-008 - consulta en blanco: expects 422 SLHD_RETR_00009
GET {{baseUrl}}/api/knowledge/search?query=%20%20

> {% client.test("422", function() { client.assert(response.status === 422); }); %}

### Edge "caracteres especiales": { } & + # % y acentos llegan sin alterarse: expects 200
GET {{baseUrl}}/api/knowledge/search?query=%C2%BF%7Bx%7D%20%26%20a%2Bb%20%231%20100%25%20env%C3%ADos%3F

> {% client.test("200", function() { client.assert(response.status === 200); }); %}

