### US4 / V15 · GET con un token distinto — expects 403 SLHD_EVAL_00001 y el token no vuelve en la respuesta
GET {{baseUrl}}/api/eval/settings
Accept: application/json
X-Eval-Token: otro-valor

> {%
  client.test("un token distinto no entra", function () {
    client.assert(response.status === 403, "status esperado 403");
    client.assert(JSON.stringify(response.body).indexOf("otro-valor") === -1, "el token no debe volver");
  });
%}
