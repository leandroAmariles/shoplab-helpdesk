### US4 / V15 · GET sin la cabecera del token — expects 403 SLHD_EVAL_00001 (guardado apagado o token ausente)
GET {{baseUrl}}/api/eval/runs/{{runId}}
Accept: application/json

> {%
  client.test("sin token no se entra", function () {
    client.assert(response.status === 403, "status esperado 403");
    client.assert(response.body.code === "SLHD_EVAL_00001", "código esperado SLHD_EVAL_00001");
  });
