<?xml version="1.0" encoding="UTF-8"?>
<!-- GitHub Packages asks for credentials even for public packages. No credential lives here: the token is read from
     the environment. Used by CI and the image build; locally put the same servers in ~/.m2/settings.xml. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
    <servers>
        <server>
            <id>github-shoplab-contracts</id>
            <username>x-access-token</username>
            <password>${env.GITHUB_TOKEN}</password>
        </server>
        <server>
            <id>github-shoplab-retrieval</id>
            <username>x-access-token</username>
            <password>${env.GITHUB_TOKEN}</password>
        </server>
        <!-- distributionManagement: publishing the stubs of this repository. -->
        <server>
            <id>github</id>
            <username>x-access-token</username>
            <password>${env.GITHUB_TOKEN}</password>
        </server>
    </servers>
</settings>
