# docker-compose.override.yml.example
#
# Uso: Copia este archivo a infra/docker-compose.override.yml y descomenta
# el servicio que estes desarrollando en tu maquina local.
#
# Docker Compose fusiona automaticamente infra/docker-compose.override.yml
# con infra/docker-compose.yml al ejecutar cualquier comando docker compose.
# Las rutas relativas 'context' apuntan a los repositorios hermanos clonados
# en carpetas adyacentes a shoplab-helpdesk (../../shoplab-*).

services:
  # Descomentar para construir y depurar shoplab-frontend desde el repo clonado al lado:
  # frontend:
  #   build:
  #     context: ../../shoplab-frontend
  #   image: shoplab-frontend:local

  # Descomentar para construir y depurar shoplab-ingest desde el repo clonado al lado:
  # ingest:
  #   build:
  #     context: ../../shoplab-ingest
  #   image: shoplab-ingest:local

  # Descomentar para construir shoplab-gateway desde el repo clonado al lado. Un prefijo nuevo se declara aqui:
  # gateway:
  #   build:
  #     context: ../../shoplab-gateway
  #   image: shoplab-gateway:local
  #   environment:
  #     SHOPLAB_GATEWAY_ROUTES_CATALOG_PREFIX: /api/catalog
  #     SHOPLAB_GATEWAY_ROUTES_CATALOG_URI: http://catalog-service:8080

  # Construir shoplab-eval-service localmente (LAB-130):
  # eval-service:
  #   build:
  #     context: ../../shoplab-eval-service
  #   image: shoplab-eval-service:local

  # Construir shoplab-retrieval-service localmente:
  # retrieval-service:
  #   build:
  #     context: ../../shoplab-retrieval-service
  #   image: shoplab-retrieval-service:local

  # Construir shoplab-chat-service localmente (LAB-59):
  # chat-service:
  #   build:
  #     context: ../../shoplab-chat-service
  #   image: shoplab-chat-service:local
