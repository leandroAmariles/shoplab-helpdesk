# Copia este archivo a infra/.env para personalizar el entorno local.
# infra/.env esta excluido de git: no versiones secretos reales.
# Todos los valores tienen un defecto equivalente en docker-compose.yml.

POSTGRES_IMAGE=pgvector/pgvector:0.8.7-pg16
POSTGRES_DB=shoplab
POSTGRES_USER=shoplab
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

OLLAMA_IMAGE=ollama/ollama:0.40.8
OLLAMA_PORT=11434
# Modelos recomendados segun RAM/GPU: ver README.md
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=bge-m3

# Perfil observability (LAB-102): `docker compose -f infra/docker-compose.yml --profile observability up -d --wait`
PROMETHEUS_IMAGE=prom/prometheus:v3.15.0
PROMETHEUS_PORT=9090
GRAFANA_IMAGE=grafana/grafana:13.2.4
GRAFANA_PORT=3000
# Solo para uso local: no reutilices esta contrasena fuera de tu maquina.
GRAFANA_ADMIN_PASSWORD=change-me-local-only
