# Copia este archivo a infra/.env para personalizar el entorno local.
# infra/.env esta excluido de git: no versiones secretos reales.
# Todos los valores tienen un defecto equivalente en docker-compose.yml.

POSTGRES_IMAGE=pgvector/pgvector:0.8.7-pg16
POSTGRES_DB=shoplab
POSTGRES_USER=shoplab
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

OLLAMA_IMAGE=ollama/ollama:0.40.8
OLLAMA_PORT=11434
# Modelos recomendados segun RAM/GPU: ver README.md
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=bge-m3

# Perfil observability (LAB-102): `docker compose -f infra/docker-compose.yml --profile observability up -d --wait`
PROMETHEUS_IMAGE=prom/prometheus:v3.15.0
PROMETHEUS_PORT=9090
GRAFANA_IMAGE=grafana/grafana:13.2.4
GRAFANA_PORT=3000
# Solo para uso local: no reutilices esta contrasena fuera de tu maquina.
GRAFANA_ADMIN_PASSWORD=change-me-local-only

# Perfil llmops (LAB-64): `docker compose -f infra/docker-compose.yml --profile llmops up -d --wait`
# Langfuse v4 autoalojado: interfaz en http://localhost:${LANGFUSE_PORT}. Todo lo de abajo es SOLO para uso local.
LANGFUSE_WEB_IMAGE=docker.langfuse.com/langfuse/langfuse:4.77.0
LANGFUSE_WORKER_IMAGE=docker.langfuse.com/langfuse/langfuse-worker:4.77.0
LANGFUSE_CLICKHOUSE_IMAGE=docker.io/clickhouse/clickhouse-server:26.3.62.3
LANGFUSE_REDIS_IMAGE=docker.io/redis:7.4.6
LANGFUSE_POSTGRES_IMAGE=docker.io/postgres:17.7
# MinIO ya no publica imagenes con tag: se fija por digest (indice multi-arquitectura).
LANGFUSE_MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:fb893e36fc369d41e92f678b17ec27378fa5bf0576aeef7ac15460c13629ab5a
# 3000 es de Grafana (perfil observability), por eso Langfuse sale por 3001.
LANGFUSE_PORT=3001
LANGFUSE_MINIO_PORT=9092
# Proyecto, usuario y claves que Langfuse crea al arrancar (el backend usa las claves en SHOPLAB_CHAT_TRACING_*).
LANGFUSE_INIT_PUBLIC_KEY=pk-lf-shoplab-local
LANGFUSE_INIT_SECRET_KEY=sk-lf-shoplab-local
LANGFUSE_INIT_USER_EMAIL=admin@shoplab.local
LANGFUSE_INIT_USER_PASSWORD=change-me-local-only
LANGFUSE_POSTGRES_PASSWORD=change-me-local-only
LANGFUSE_CLICKHOUSE_PASSWORD=change-me-local-only
LANGFUSE_REDIS_AUTH=change-me-local-only
LANGFUSE_MINIO_PASSWORD=change-me-local-only
LANGFUSE_SALT=change-me-local-only
LANGFUSE_NEXTAUTH_SECRET=change-me-local-only
# Debe tener 64 caracteres hexadecimales.
LANGFUSE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
