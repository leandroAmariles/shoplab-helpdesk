# Copia este archivo a infra/.env para personalizar el entorno local.
# infra/.env esta excluido de git: no versiones secretos reales.
# Todos los valores tienen un defecto equivalente en docker-compose.yml.

POSTGRES_IMAGE=pgvector/pgvector:0.8.7-pg16
POSTGRES_DB=shoplab
POSTGRES_USER=shoplab
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

OLLAMA_IMAGE=ollama/ollama:0.40.8
# Ollama ya no publica puerto (solo lo usa el gateway). OLLAMA_PORT solo aplica con
# `-f infra/docker-compose.ollama-host.yml` (Ollama del host de DEV y mediciones).
OLLAMA_PORT=11434
# Modelos recomendados segun RAM/GPU: ver README.md
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=bge-m3
# Modelo de respaldo del gateway: si se define, Ollama tambien lo descarga (fallback entre dos modelos locales).
OLLAMA_FALLBACK_MODEL=

# Perfil observability (LAB-102): `docker compose -f infra/docker-compose.yml --profile observability up -d --wait`
PROMETHEUS_IMAGE=prom/prometheus:v3.15.0
PROMETHEUS_PORT=9090
GRAFANA_IMAGE=grafana/grafana:13.2.4
GRAFANA_PORT=3000
# Solo para uso local: no reutilices esta contrasena fuera de tu maquina.
GRAFANA_ADMIN_PASSWORD=change-me-local-only

# Perfil llmops (LAB-64): `docker compose -f infra/docker-compose.yml --profile llmops up -d --wait`
# Langfuse v4 autoalojado: interfaz en http://localhost:${LANGFUSE_PORT}. Todo lo de abajo es SOLO para uso local.
LANGFUSE_WEB_IMAGE=docker.langfuse.com/langfuse/langfuse:4.77.0
LANGFUSE_WORKER_IMAGE=docker.langfuse.com/langfuse/langfuse-worker:4.77.0
LANGFUSE_CLICKHOUSE_IMAGE=docker.io/clickhouse/clickhouse-server:26.3.62.3
LANGFUSE_REDIS_IMAGE=docker.io/redis:7.4.6
LANGFUSE_POSTGRES_IMAGE=docker.io/postgres:17.7
# MinIO ya no publica imagenes con tag: se fija por digest (indice multi-arquitectura).
LANGFUSE_MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:fb893e36fc369d41e92f678b17ec27378fa5bf0576aeef7ac15460c13629ab5a
# 3000 es de Grafana (perfil observability), por eso Langfuse sale por 3001.
LANGFUSE_PORT=3001
LANGFUSE_MINIO_PORT=9092
# Proyecto, usuario y claves que Langfuse crea al arrancar (chat-service usa las claves en SHOPLAB_CHAT_TRACING_*).
LANGFUSE_INIT_PUBLIC_KEY=pk-lf-shoplab-local
LANGFUSE_INIT_SECRET_KEY=sk-lf-shoplab-local
LANGFUSE_INIT_USER_EMAIL=admin@shoplab.local
LANGFUSE_INIT_USER_PASSWORD=change-me-local-only
LANGFUSE_POSTGRES_PASSWORD=change-me-local-only
LANGFUSE_CLICKHOUSE_PASSWORD=change-me-local-only
LANGFUSE_REDIS_AUTH=change-me-local-only
LANGFUSE_MINIO_PASSWORD=change-me-local-only
LANGFUSE_SALT=change-me-local-only
LANGFUSE_NEXTAUTH_SECRET=change-me-local-only
# Debe tener 64 caracteres hexadecimales.
LANGFUSE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Gateway de modelos LiteLLM (LAB-84). Todo lo de abajo es SOLO para uso local.
# Los servicios hablan unicamente con el gateway: http://localhost:${LITELLM_PORT}/v1, cada uno con su clave virtual.
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.109.1
LITELLM_POSTGRES_IMAGE=docker.io/postgres:17.7
LITELLM_PORT=4000
# LiteLLM exige el formato `sk-...`; estos valores son marcadores locales, no secretos.
LITELLM_MASTER_KEY=sk-shoplab-master-local-only
LITELLM_KEY_INGEST=sk-shoplab-ingest-local
# Clave de la evaluacion de calidad de respuesta (LAB-29): solo llama a `judge` y `embeddings`, con presupuesto propio.
LITELLM_KEY_EVAL=sk-shoplab-eval-local
LITELLM_POSTGRES_PASSWORD=change-me-local-only
GATEWAY_ENVIRONMENT=local
# Modelos reales detras de los nombres logicos `chat` y `embeddings` (vacio = OLLAMA_CHAT_MODEL / OLLAMA_EMBED_MODEL).
# Cambiar el de embeddings con otra dimension de vector exige reindexar (ADR-0003).
LITELLM_CHAT_PRIMARY_MODEL=
LITELLM_CHAT_FALLBACK_MODEL=llama3.2:1b
LITELLM_EMBED_MODEL=
# Juez de la evaluacion de calidad de respuesta (LAB-29), tras el nombre logico `judge`. llama3.2:3b (el chat) NO sirve: no
# rellena las salidas estructuradas del juez. Por defecto el gateway usa qwen2.5:7b (~4,7 GB, caben en una GPU de 12 GB junto
# al chat). OLLAMA_JUDGE_MODEL hace que Ollama lo descargue (vacio = no se descarga: solo quien evalua lo necesita);
# LITELLM_JUDGE_MODEL cambia el modelo que usa el gateway (vacio = OLLAMA_JUDGE_MODEL o qwen2.5:7b).
OLLAMA_JUDGE_MODEL=
LITELLM_JUDGE_MODEL=
# Precios de REFERENCIA por token (no son dinero real): permiten medir y presupuestar modelos locales (opcional).
# LITELLM_CHAT_PRIMARY_INPUT_COST=0.00000015
# LITELLM_CHAT_PRIMARY_OUTPUT_COST=0.0000006
# Proveedor cloud opcional: vacio = el modelo `chat-cloud` no existe y el gateway no sale a Internet.
CLOUD_PROVIDER_API_KEY=
CLOUD_PROVIDER_MODEL=
CLOUD_PROVIDER_API_BASE=

# Evaluacion de la calidad de respuesta (LAB-29): `uv run python -m shoplab_eval quality` en eval/ lee estas variables.
# Son valores LOCALES de docker compose; las de DEV las lee `make quality` de shoplab-infra desde el cluster.
# SHOPLAB_EVAL_JUDGE_API_KEY=sk-shoplab-eval-local
# SHOPLAB_EVAL_JUDGE_BASE_URL=http://localhost:4000/v1
# Modelo de chat del gateway: ningun servicio lo expone y sin el el resultado lo registra como `unknown`.
# SHOPLAB_EVAL_ASSISTANT_MODEL=llama3.2:3b
# Para adjuntar las puntuaciones a las trazas (perfil `llmops` y SHOPLAB_CHAT_TRACING_ENABLED=true en chat-service):
# SHOPLAB_EVAL_LANGFUSE_HOST=http://localhost:3001
# SHOPLAB_EVAL_LANGFUSE_PUBLIC_KEY=pk-lf-shoplab-local
# SHOPLAB_EVAL_LANGFUSE_SECRET_KEY=sk-lf-shoplab-local

# ==============================================================================
# Servicios de Aplicación (GHCR - LAB-110)
# ==============================================================================
# Versiones inmutables fijadas por release (prohibido :latest)
FRONTEND_IMAGE=ghcr.io/leandroamariles/frontend:v0.26.0
INGEST_IMAGE=ghcr.io/leandroamariles/ingest:v0.26.0
GATEWAY_IMAGE=ghcr.io/leandroamariles/gateway:v0.1.0

# Puertos de publicación en el host. La API entra por el gateway (LAB-107); cada servicio publica ademas
# un puerto propio solo para depurar.
GATEWAY_PORT=8080
FRONTEND_PORT=4200
INGEST_PORT=8000

# Mover una ruta de la API a un servicio extraído (docs/fases/F5-mover-rutas-al-gateway.md):
# /api/documents y /api/knowledge ya van a retrieval-service por defecto (LAB-129).
# SHOPLAB_GATEWAY_ROUTES_CHAT_URI=http://<servicio>:8080

# retrieval-service (LAB-129). La contrasena es la del rol `retrieval`; en dev debe coincidir con
# retrieval-db-password de shoplab-infra.
RETRIEVAL_DB_PASSWORD=change-me-local-only
RETRIEVAL_PORT=8082
LITELLM_KEY_RETRIEVAL=sk-shoplab-retrieval-local

# chat-service (LAB-59). La contrasena es la del rol `chat`; en dev debe coincidir con
# chat-db-password de shoplab-infra.
CHAT_DB_PASSWORD=change-me-local-only
CHAT_PORT=8083
LITELLM_KEY_CHAT=sk-shoplab-chat-local

# eval-service (LAB-130). La contrasena es la del rol `eval`; en dev debe coincidir con
# eval-db-password de shoplab-infra.
EVAL_DB_PASSWORD=change-me-local-only
EVAL_PORT=8084
# Token que exigen POST /api/eval/runs y GET /api/eval/settings (vacio = guardado desactivado).
# SHOPLAB_EVAL_PERSISTENCE_TOKEN=change-me-local-only
